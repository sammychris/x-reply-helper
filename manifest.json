{
  "manifest_version": 3,
  "name": "Sammy's Reply Helper & Post Picker for X",
  "version": "1.5.0",
  "description": "Reads a post (text and images) and drafts reply ideas in your voice. You pick, edit and press Reply yourself.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "https://pbs.twimg.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Reply Helper settings" }
}
